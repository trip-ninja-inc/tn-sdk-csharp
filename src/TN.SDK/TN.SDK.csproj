<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- NuGet metadata -->
    <PackageId>TripNinja.SDK</PackageId>
    <Version>0.0.3</Version>
    <Authors>Trip Ninja</Authors>
    <Company>Trip Ninja</Company>
    <Description>The official Trip Ninja SDK for interacting with the Trip Ninja API.</Description>
    <Copyright>© 2026 Trip Ninja. All rights reserved.</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/trip-ninja-inc/tn-sdk-csharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/trip-ninja-inc/tn-sdk-csharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>TripNinja;SDK;API;Travel</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>
    Version 0.0.3 Features &amp; Improvements:
      - **Configuration Integration:** Added native support for `IConfiguration`. You can now initialize `TnApi` directly using `appsettings.json` or standard .NET configuration providers.
      - **Environment Variables:** Enhanced support for Environment Variables using standard .NET naming conventions (e.g., `TripNinja__ClientId`).
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="../../LICENSE" Pack="true" PackagePath="\" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>TN.SDK.Test</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.2" />
  </ItemGroup>

</Project>
